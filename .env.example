# Google Gemini API Key (Required)
# Get a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration
PORT=4000
NODE_ENV=development

# FORTRESS Vault Gatekeeper & Master Pass
# Set this to a strong password. Anyone without this pass or an authorized client key will be blocked!
VAULT_MASTER_KEY=fortress_master_vault_pass_2026!

# Optional pre-authorized client keys (Comma-separated name:key or JSON)
# Example: VAULT_AUTHORIZED_KEYS=alex:vlt_live_abc123,sarah:vlt_live_xyz789
VAULT_AUTHORIZED_KEYS=

# Optional legacy key for backward compatibility
FORTRESS_API_KEY=

# Allowed origins for CORS (comma-separated, or * for all during local dev)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://yourdomain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20

# Max code payload length (characters)
MAX_CODE_CHARS=30000

# Gemini Model (e.g., gemini-2.5-pro, gemini-2.0-flash, gemini-1.5-pro)
GEMINI_MODEL=gemini-2.5-pro

# Alerting & Scheduled Intelligence Dispatch (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# AI Threat Intelligence Digest Schedule (Hours: 1, 6, 12, or 24)
REPORT_INTERVAL_HOURS=24

