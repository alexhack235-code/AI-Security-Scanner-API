# Google Gemini API Key (Required)
# Get a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration
PORT=4000
NODE_ENV=development

# FORTRESS Security Guard Settings
# Optional API Key for clients accessing this scanner (leave empty to disable client auth)
FORTRESS_API_KEY=

# Allowed origins for CORS (comma-separated, or * for all during local dev)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://yourdomain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20

# Max code payload length (characters)
MAX_CODE_CHARS=30000

# Gemini Model (e.g., gemini-2.5-pro, gemini-2.0-flash, gemini-1.5-pro)
GEMINI_MODEL=gemini-2.5-pro

# Alerting Integrations (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
